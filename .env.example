# ==============================================================================
# PLN ICON PLUS MULTIMEDIA STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi '.env' atau '.env.local' untuk konfigurasi lokal Anda:
#    cp .env.example .env.local
# 2. JANGAN PERNAH meng-commit file '.env' atau '.env.local' asli ke Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE CONFIGURATION (AWS ap-southeast-1 Singapore)
# ------------------------------------------------------------------------------
# Dapatkan connection string langsung dari Dashboard Neon:
# Dashboard Neon -> Project: multimedia-dashboard -> Connection Details

# Pooled Connection URL (Direkomendasikan untuk Next.js / Serverless API routes):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-multimedia-dashboard-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled Connection URL (Gunakan untuk DDL / Migration / Prisma / Drizzle):
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-multimedia-dashboard.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Parameter Koneksi Terpisah (Jika menggunakan native node-postgres / pg / Docker):
PGHOST="ep-multimedia-dashboard-pooler.ap-southeast-1.aws.neon.tech"
PGDATABASE="neondb"
PGUSER="neondb_owner"
PGPASSWORD="YOUR_NEON_PASSWORD"
PGPORT=5432
PGSSLMODE="require"

# ------------------------------------------------------------------------------
# 2. NEON AUTH (Authentication)
# ------------------------------------------------------------------------------
# Konfigurasi jika mengaktifkan Neon Auth untuk autentikasi pengguna & sesi:
NEXT_PUBLIC_NEON_AUTH_URL="https://auth.neon.tech/api/v1"
NEON_AUTH_SECRET="YOUR_NEON_AUTH_SECRET_KEY"

# LPP uses Managed Better Auth. The two legacy variables above are not sufficient.
# Copy the branch Auth URL from Neon Console. Never use NEXT_PUBLIC for secrets.
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
# Central application access. If omitted, inherits the existing LPP settings below.
# If explicitly empty, access is denied. Keep these server-side.
# APP_ALLOWED_EMAILS=""
# APP_MANUALLY_APPROVED_ACCOUNTS='{}'
# Emergency controls take effect after server restart / Vercel redeploy.
APP_ACCESS_DISABLED="false"
APP_SESSIONS_VALID_AFTER=""
# Shared rate limiter: scoped app_security_runtime role, same development branch.
SECURITY_DATABASE_URL=""
# Local migrations ONLY: direct owner URL. Never add this to Vercel runtime env.
SECURITY_MIGRATION_DATABASE_URL=""
# Leave empty on Vercel (its x-vercel-forwarded-for is used automatically).
# For another trusted proxy, configure ONLY a header that the proxy overwrites.
APP_TRUSTED_IP_HEADER=""
# Exact verified email addresses, comma-separated. Empty denies everyone.
LPP_ALLOWED_EMAILS=""
# Optional explicit manual enrollment: JSON mapping exact email to Neon Auth user ID.
# These accounts may access LPP without email OTP; login and email allowlist still apply.
# Never derive this map from browser input or expose it with NEXT_PUBLIC.
LPP_MANUALLY_APPROVED_ACCOUNTS='{}'
# SHA-256 of the private template filename selected for the first input form.
# Configure on the server; do not include names or template contents in public code.
LPP_FORM_TEMPLATE_ID=""
# Filename SHA-256 for the private documentation table layout (7 rows, 10 photos).
LPP_DOCUMENTATION_TEMPLATE_ID=""
# Filename SHA-256 for the second documentation layout (51 report entries, 49 photos).
LPP_AUDITORIUM_TEMPLATE_ID=""
# Filename SHA-256 for Auditorium phase 1 (14 report entries and 14 photos).
LPP_AUDITORIUM_PHASE1_TEMPLATE_ID=""
# Filename SHA-256 for the collaboration-room layout (10 materials, 14 photos).
LPP_COLLABORATION_TEMPLATE_ID=""
# Filename SHA-256 for the 11-material videowall layout (38 report rows, 24 documentation rows, 13 photos).
LPP_PBH_TEMPLATE_ID=""
# Filename SHA-256 for the 24-material SOC videowall layout (49 report rows, 37 documentation rows, 25 photos).
LPP_SOC_TEMPLATE_ID=""
# Set the exact public origin in production for mutation CSRF protection.
APP_ORIGIN="http://localhost:3000"
# Development default: ./private. For a server with a private persistent volume:
LPP_PRIVATE_DIR=""
# On Vercel use a PRIVATE S3-compatible bucket (never public URLs).
# Object keys: data-lpp/<original filename>.xlsx; lpp-drafts/<hashed-user-id>/<uuid>.json
# Uploaded photos: lpp-photos/<hashed-user-id>/<sha256>.jpg (private, owner-scoped).
LPP_S3_BUCKET=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 3. LOCAL DOCKER POSTGRESQL (OPSIONAL - FALLBACK PENGEMBANGAN OFFLINE)
# ------------------------------------------------------------------------------
# Jika ingin beralih ke database lokal Docker:
# LOCAL_DATABASE_URL="postgresql://pln_admin:pln_iconplus_2026@localhost:5432/pln_multimedia?schema=public"
# LOCAL_POSTGRES_DB="pln_multimedia"
# LOCAL_POSTGRES_USER="pln_admin"
# LOCAL_POSTGRES_PASSWORD="pln_iconplus_2026"
# LOCAL_POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PLN Icon Plus - Multimedia Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

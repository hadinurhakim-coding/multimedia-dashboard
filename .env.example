# ==============================================================================
# PLN ICON PLUS MULTIMEDIA STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi '.env' atau '.env.local' untuk konfigurasi lokal Anda:
#    cp .env.example .env.local
# 2. JANGAN PERNAH meng-commit file '.env' atau '.env.local' asli ke Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE CONFIGURATION (AWS ap-southeast-1 Singapore)
# ------------------------------------------------------------------------------
# Dapatkan connection string langsung dari Dashboard Neon:
# Dashboard Neon -> Project: multimedia-dashboard -> Connection Details

# Pooled Connection URL (Direkomendasikan untuk Next.js / Serverless API routes):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-multimedia-dashboard-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled Connection URL (Gunakan untuk DDL / Migration / Prisma / Drizzle):
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-multimedia-dashboard.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Parameter Koneksi Terpisah (Jika menggunakan native node-postgres / pg / Docker):
PGHOST="ep-multimedia-dashboard-pooler.ap-southeast-1.aws.neon.tech"
PGDATABASE="neondb"
PGUSER="neondb_owner"
PGPASSWORD="YOUR_NEON_PASSWORD"
PGPORT=5432
PGSSLMODE="require"

# ------------------------------------------------------------------------------
# 2. NEON AUTH (Authentication)
# ------------------------------------------------------------------------------
# Konfigurasi jika mengaktifkan Neon Auth untuk autentikasi pengguna & sesi:
NEXT_PUBLIC_NEON_AUTH_URL="https://auth.neon.tech/api/v1"
NEON_AUTH_SECRET="YOUR_NEON_AUTH_SECRET_KEY"

# ------------------------------------------------------------------------------
# 3. LOCAL DOCKER POSTGRESQL (OPSIONAL - FALLBACK PENGEMBANGAN OFFLINE)
# ------------------------------------------------------------------------------
# Jika ingin beralih ke database lokal Docker:
# LOCAL_DATABASE_URL="postgresql://pln_admin:pln_iconplus_2026@localhost:5432/pln_multimedia?schema=public"
# LOCAL_POSTGRES_DB="pln_multimedia"
# LOCAL_POSTGRES_USER="pln_admin"
# LOCAL_POSTGRES_PASSWORD="pln_iconplus_2026"
# LOCAL_POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PLN Icon Plus - Multimedia Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
